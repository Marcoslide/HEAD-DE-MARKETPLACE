# API do Head Marketplace OS — build determinístico, sem dependências npm
FROM node:22-slim
WORKDIR /app
COPY package.json ./
COPY mie ./mie
COPY mos ./mos
COPY design/prototipo-v8/import-engine.js ./design/prototipo-v8/import-engine.js
COPY apps/api ./apps/api
COPY infrastructure/scripts ./infrastructure/scripts
ENV NODE_ENV=production HEAD_DATA_DIR=/data
VOLUME /data
EXPOSE 3080
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://localhost:3080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "node infrastructure/scripts/db.js migrate && node apps/api/server.js"]
