# ============================================================================
# Marketplace Operating System — variáveis de ambiente (MODO ATIVAÇÃO REAL)
# ============================================================================
# Este arquivo contém APENAS nomes, explicações e exemplos NÃO sensíveis.
# NUNCA coloque valores reais aqui, no Git, no chat, em fixtures ou em logs.
# Copie para `.env` (fora do Git) ou defina direto no painel do seu host.
#
# Regra de ouro: toda credencial vive SOMENTE como variável de ambiente do
# servidor. O frontend nunca vê client secret, access token ou app secret.
# ============================================================================

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Porta local do processo Node. O proxy HTTPS do seu host aponta para ela.
PORT=3000

# URL pública HTTPS do backend (sem barra final). Usada para montar as URLs
# de callback/webhook exibidas na ativação. Exemplo seguro (não real):
PUBLIC_BASE_URL=https://mos.exemplo.com.br

# Arquivo do banco SQLite (caminho persistente no host; faça backup antes
# do piloto). Em memória (:memory:) NUNCA em produção.
MOS_DB_FILE=./data/mos.db

# Chave do vault de credenciais (AES-256-GCM) — 32 bytes em hexadecimal
# (64 caracteres hex). Gere com:  openssl rand -hex 32
# Sem ela o vault usa uma chave de desenvolvimento — NÃO ative nada real
# sem definir esta variável.
MOS_CREDENTIAL_KEY=

# ---------------------------------------------------------------------------
# Mercado Livre — OAuth oficial (developers.mercadolivre.com.br)
# ---------------------------------------------------------------------------
# Client ID do seu app (Minhas aplicações → sua aplicação). Não é segredo,
# mas trate como configuração de servidor.
ML_CLIENT_ID=

# Client Secret do app. SEGREDO: nunca vai ao frontend, ao Git ou a logs.
ML_CLIENT_SECRET=

# Redirect URI HTTPS registrada no app — precisa ser EXATAMENTE igual à
# registrada no painel do Mercado Livre:
#   https://SEU-DOMINIO/oauth/ml/callback
ML_REDIRECT_URI=https://mos.exemplo.com.br/oauth/ml/callback

# ---------------------------------------------------------------------------
# WhatsApp Business — via oficial Meta (developers.facebook.com)
# ---------------------------------------------------------------------------
# Token oficial (System User token com escopo WhatsApp). SEGREDO.
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID do número comercial (painel WhatsApp do app Meta).
WHATSAPP_PHONE_NUMBER_ID=

# WABA ID (WhatsApp Business Account ID).
WHATSAPP_WABA_ID=

# Verify token do webhook — VOCÊ inventa este valor e cadastra o MESMO
# no painel da Meta ao configurar o webhook. Exemplo de formato (não use
# este): um texto aleatório longo, ex. saída de `openssl rand -hex 16`.
WHATSAPP_VERIFY_TOKEN=

# App Secret do app Meta — usado para validar a assinatura HMAC-SHA256
# (X-Hub-Signature-256) de cada webhook recebido. SEGREDO.
WHATSAPP_APP_SECRET=

# Allowlist do piloto de resposta: números E.164 separados por vírgula.
# Só estes números podem receber resposta do Head (e só com a flag ligada).
# Exemplo de formato (não real):
WHATSAPP_ADMIN_ALLOWLIST=5511988887777

# ---------------------------------------------------------------------------
# Criativos — geração de imagem (opcional; default: desligado)
# ---------------------------------------------------------------------------
# Nome do provider de geração de imagem (quando contratado). Sem provider,
# o sistema prepara briefing + fila pendente e NUNCA finge uma imagem.
CREATIVE_IMAGE_PROVIDER=

# Chave de API do provider. SEGREDO: só no backend.
CREATIVE_IMAGE_API_KEY=

# ============================================================================
# Lembrete: as FEATURE FLAGS (WHATSAPP_INBOUND_ENABLED, MERCADO_LIVRE_OAUTH_
# ENABLED, etc.) NÃO são variáveis de ambiente — elas vivem no banco, por
# empresa/conta/usuário, e nascem TODAS desligadas. Ligue-as uma a uma pela
# ordem do runbook (docs/live-activation-checklist.md).
# ============================================================================
